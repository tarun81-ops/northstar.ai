# Copy to .env and fill in. Never commit .env.
NORTHSTAR_MODEL=openai:gpt-6-luna
OPENAI_API_KEY=
# Only if you switch NORTHSTAR_MODEL to google_genai:...
GOOGLE_API_KEY=
# Optional. Default: SQLite file at data/northstar.db. Later e.g. postgresql+psycopg://user:pass@host/db
# DATABASE_URL=

# Kaggle credentials (optional, required to download datasets in Research Studio).
# Create a token at https://www.kaggle.com/settings -> "Create New Token"
KAGGLE_USERNAME=
KAGGLE_KEY=
# Optional dataset limits and storage location
# KAGGLE_MAX_DATASET_SIZE_MB=50.0
# KAGGLE_STUDENT_STORAGE_CAP_MB=100.0
# DATASET_WORKSPACE_ROOT=
